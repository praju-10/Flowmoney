{
  "name": "flowmoney",
  "version": "0.2.0",
  "private": true,
  "description": "FlowMoney \u2014 private, on-device personal finance (installable web app)",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "dev:lan": "npm run dev -w client -- --host",
    "build": "npm run build -w client",
    "preview": "npm run preview -w client",
    "test": "npm run test -w server",
    "export-data": "npm run export-data -w server",
    "dev:server": "npm run dev -w server",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "@eslint/js": "^9.12.0",
    "globals": "^15.11.0"
  },
  "engines": {
    "node": ">=20"
  }
}